import joblib


class TradePredictor:

    def __init__(
        self,
        model_path,
        threshold=0.65
    ):

        package = joblib.load(
            model_path
        )

        self.model = package["model"]
        self.features = package["features"]
        self.threshold = threshold

    def predict(self, row):

        X = row[
            self.features
        ]

        probability = float(
            self.model.predict_proba(X)[0][1]
        )

        decision = (
            "ACCEPT"
            if probability >= self.threshold
            else "AVOID"
        )

        return probability, decision

    def reason(
        self,
        row,
        probability,
        decision
    ):

        reasons = []

        if row["ltq_change"] > 0:
            reasons.append(
                "LTQ increasing"
            )
        else:
            reasons.append(
                "LTQ decreasing"
            )

        if row["ltq_acceleration"] > 0:
            reasons.append(
                "LTQ acceleration positive"
            )
        else:
            reasons.append(
                "LTQ acceleration weakening"
            )

        if row["bid_ask_imbalance"] > 0.15:
            reasons.append(
                "Strong bid support"
            )

        elif row["bid_ask_imbalance"] < -0.15:
            reasons.append(
                "Strong ask pressure"
            )

        else:
            reasons.append(
                "Balanced order book"
            )

        if row["smma20_slope"] > 0:
            reasons.append(
                "SMMA20 rising"
            )
        else:
            reasons.append(
                "SMMA20 weakening"
            )

        return (
            f"{decision} | "
            f"Probability={probability:.2%} | "
            + "; ".join(reasons)
        )
