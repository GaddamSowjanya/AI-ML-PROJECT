import argparse
from pathlib import Path

import joblib
import pandas as pd

from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score
)

from app.indicators.smma import add_smma

from app.features.feature_engineering import (
    create_features,
    detect_crossovers,
    FEATURE_COLUMNS
)


TARGET = 0.006
STOP = 0.003
LOOK_AHEAD = 15


def create_labels(df):

    df = df.copy()
    df["target"] = None

    for symbol, group in df.groupby("symbol"):

        group = group.sort_values(
            "timestamp"
        )

        indices = group.index.tolist()
        prices = group["close"].values
        signals = group["signal"].values

        for i, idx in enumerate(indices):

            signal = signals[i]

            if signal == 0:
                continue

            entry = prices[i]
            outcome = None

            end = min(
                i + LOOK_AHEAD + 1,
                len(prices)
            )

            for j in range(i + 1, end):

                trade_return = (
                    signal
                    * (prices[j] / entry - 1)
                )

                if trade_return >= TARGET:
                    outcome = 1
                    break

                if trade_return <= -STOP:
                    outcome = 0
                    break

            if outcome is None:

                final_return = (
                    signal
                    * (
                        prices[end - 1]
                        / entry
                        - 1
                    )
                )

                outcome = int(
                    final_return > 0
                )

            df.loc[idx, "target"] = outcome

    return df


def prepare_data(path):

    df = pd.read_csv(path)

    df["timestamp"] = pd.to_datetime(
        df["timestamp"]
    )

    df = df.sort_values(
        ["symbol", "timestamp"]
    )

    df = (
        df.groupby(
            "symbol",
            group_keys=False
        )
        .apply(add_smma)
        .reset_index(drop=True)
    )

    df = create_features(df)

    df = detect_crossovers(df)

    df = create_labels(df)

    df = df[
        df["signal"] != 0
    ]

    df = df.dropna(
        subset=FEATURE_COLUMNS + ["target"]
    )

    return df


def train(df):

    X = df[FEATURE_COLUMNS]
    y = df["target"].astype(int)

    split = int(
        len(df) * 0.80
    )

    X_train = X.iloc[:split]
    X_test = X.iloc[split:]

    y_train = y.iloc[:split]
    y_test = y.iloc[split:]

    model = RandomForestClassifier(
        n_estimators=400,
        max_depth=8,
        min_samples_leaf=5,
        class_weight="balanced",
        random_state=42,
        n_jobs=-1
    )

    model.fit(
        X_train,
        y_train
    )

    predictions = model.predict(
        X_test
    )

    print(
        "Accuracy:",
        accuracy_score(
            y_test,
            predictions
        )
    )

    print(
        "Precision:",
        precision_score(
            y_test,
            predictions,
            zero_division=0
        )
    )

    print(
        "Recall:",
        recall_score(
            y_test,
            predictions,
            zero_division=0
        )
    )

    print(
        "F1:",
        f1_score(
            y_test,
            predictions,
            zero_division=0
        )
    )

    return model


def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--input",
        required=True
    )

    parser.add_argument(
        "--output",
        required=True
    )

    args = parser.parse_args()

    df = prepare_data(
        args.input
    )

    if len(df) < 50:

        raise ValueError(
            "Not enough crossover samples."
        )

    model = train(df)

    package = {
        "model": model,
        "features": FEATURE_COLUMNS
    }

    Path(
        args.output
    ).parent.mkdir(
        parents=True,
        exist_ok=True
    )

    joblib.dump(
        package,
        args.output
    )

    print(
        "Model saved:",
        args.output
    )


if __name__ == "__main__":
    main()
