import pandas as pd


def smma(series, period):

    result = pd.Series(
        index=series.index,
        dtype=float
    )

    if len(series) < period:
        return result

    result.iloc[period - 1] = (
        series.iloc[:period].mean()
    )

    for i in range(period, len(series)):

        result.iloc[i] = (
            (
                result.iloc[i - 1]
                * (period - 1)
            )
            + series.iloc[i]
        ) / period

    return result


def add_smma(df):

    df = df.copy()

    df["smma20"] = smma(
        df["close"],
        20
    )

    df["smma120"] = smma(
        df["close"],
        120
    )

    df["smma_spread"] = (
        df["smma20"]
        - df["smma120"]
    )

    df["smma_spread_pct"] = (
        df["smma_spread"]
        / df["smma120"]
    )

    df["smma20_slope"] = (
        df["smma20"].diff()
    )

    df["smma120_slope"] = (
        df["smma120"].diff()
    )

    return df
