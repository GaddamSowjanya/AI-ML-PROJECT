import argparse
import joblib
import pandas as pd

from app.indicators.smma import add_smma

from app.features.feature_engineering import (
    create_features,
    detect_crossovers,
    FEATURE_COLUMNS
)


def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--model",
        required=True
    )

    parser.add_argument(
        "--input",
        required=True
    )

    parser.add_argument(
        "--output",
        required=True
    )

    args = parser.parse_args()

    package = joblib.load(
        args.model
    )

    model = package["model"]

    df = pd.read_csv(
        args.input
    )

    df["timestamp"] = pd.to_datetime(
        df["timestamp"]
    )

    df = (
        df.groupby(
            "symbol",
            group_keys=False
        )
        .apply(add_smma)
        .reset_index(drop=True)
    )

    df = create_features(df)

    df = detect_crossovers(df)

    signals = df[
        df["signal"] != 0
    ].copy()

