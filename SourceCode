import time


class MarketDataProcessor:

    def __init__(self):
        self.latest = {}

    def process(self, message):

        if not isinstance(message, dict):
            return None

        symbol = message.get("symbol")

        if not symbol:
            return None

        data = {
            "timestamp": message.get(
                "timestamp",
                time.time()
            ),
            "symbol": symbol,
            "ltp": message.get(
                "ltp",
                message.get("lp", 0)
            ),
            "ltq": message.get(
                "ltq",
                message.get("last_traded_qty", 0)
            ),
            "volume": message.get(
                "volume",
                message.get("vol_traded_today", 0)
            ),
            "bid_price": message.get(
                "bid_price",
                message.get("bid", 0)
            ),
            "ask_price": message.get(
                "ask_price",
                message.get("ask", 0)
            ),
            "bid_qty": message.get(
                "bid_qty",
                message.get("bid_size", 0)
            ),
            "ask_qty": message.get(
                "ask_qty",
                message.get("ask_size", 0)
            )
        }

        self.latest[symbol] = data

        return data
