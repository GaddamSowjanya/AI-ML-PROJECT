from app.config import FYERS_APP_ID, FYERS_ACCESS_TOKEN


class FyersBroker:

    def __init__(
        self,
        on_message,
        on_connect,
        on_error,
        on_close
    ):
        self.socket = data_ws.FyersDataSocket(
            access_token=f"{FYERS_APP_ID}:{FYERS_ACCESS_TOKEN}",
            log_path="",
            litemode=False,
            write_to_file=False,
            reconnect=True,
            on_connect=on_connect,
            on_message=on_message,
            on_error=on_error,
            on_close=on_close
        )

    def connect(self):
        self.socket.connect()

    def subscribe(self, symbols):
        self.socket.subscribe(
            symbols=symbols,
            data_type="SymbolUpdate"
        )

        self.socket.subscribe(
            symbols=symbols,
            data_type="DepthUpdate"
        )

        self.socket.keep_running()
