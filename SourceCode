import numpy as np
import pandas as pd


FEATURE_COLUMNS = [
    "return_1",
    "return_3",
    "return_5",
    "volume_change",
    "ltq_change",
    "ltq_acceleration",
    "bid_qty_change",
    "ask_qty_change",
    "bid_ask_imbalance",
    "imbalance_change",
    "bid_ask_spread",
    "spread_percentage",
    "price_bid_distance",
    "price_ask_distance",
    "smma_spread",
    "smma_spread_pct",
    "smma20_slope",
    "smma120_slope"
]


def create_features(df):

    df = df.copy()

    df = df.sort_values(
        ["symbol", "timestamp"]
    )

    group = df.groupby("symbol")

    df["return_1"] = (
        group["close"].pct_change(1)
    )

    df["return_3"] = (
        group["close"].pct_change(3)
    )

    df["return_5"] = (
        group["close"].pct_change(5)
    )

    df["volume_change"] = (
        group["volume"].diff()
    )

    df["ltq_change"] = (
        group["ltq"].diff()
    )

    df["ltq_acceleration"] = (
        group["ltq_change"].diff()
    )

    df["bid_qty_change"] = (
        group["bid_qty"].diff()
    )

    df["ask_qty_change"] = (
        group["ask_qty"].diff()
    )

    total_qty = (
        df["bid_qty"]
        + df["ask_qty"]
    )

    df["bid_ask_imbalance"] = (
        (
            df["bid_qty"]
            - df["ask_qty"]
        )
        / total_qty.replace(0, np.nan)
    )

    df["imbalance_change"] = (
        group["bid_ask_imbalance"].diff()
    )

    df["bid_ask_spread"] = (
        df["ask_price"]
        - df["bid_price"]
    )

    df["spread_percentage"] = (
        df["bid_ask_spread"]
        / df["close"]
    )

    df["price_bid_distance"] = (
        df["close"]
        - df["bid_price"]
    )

    df["price_ask_distance"] = (
        df["ask_price"]
        - df["close"]
    )

    return df


def detect_crossovers(df):

    df = df.copy()

    previous20 = (
        df.groupby("symbol")["smma20"]
        .shift(1)
    )

    previous120 = (
        df.groupby("symbol")["smma120"]
        .shift(1)
    )

    df["signal"] = 0

    buy = (
        (previous20 <= previous120)
        &
        (df["smma20"] > df["smma120"])
    )

    sell = (
        (previous20 >= previous120)
        &
        (df["smma20"] < df["smma120"])
    )

    df.loc[buy, "signal"] = 1
    df.loc[sell, "signal"] = -1

    return df
