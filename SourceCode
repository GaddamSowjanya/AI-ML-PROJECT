class PaperTrader:

    def __init__(
        self,
        target_pct=0.006,
        stop_pct=0.003
    ):

        self.target_pct = target_pct
        self.stop_pct = stop_pct

        self.positions = {}
        self.completed_trades = []

    def open_trade(
        self,
        symbol,
        signal,
        price,
        timestamp
    ):

        if symbol in self.positions:
            return

        self.positions[symbol] = {
            "symbol": symbol,
            "signal": signal,
            "entry_price": price,
            "entry_time": timestamp
        }

    def monitor(
        self,
        symbol,
        price,
        timestamp,
        probability,
        imbalance
    ):

        if symbol not in self.positions:
            return None

        position = self.positions[symbol]

        signal = position["signal"]
        entry = position["entry_price"]

        pnl_pct = (
            signal
            * (price / entry - 1)
        )

        reason = None

        if pnl_pct >= self.target_pct:
            reason = "TARGET"

        elif pnl_pct <= -self.stop_pct:
            reason = "STOP_LOSS"

        elif probability < 0.50:
            reason = "ML_DETERIORATION"

        elif signal == 1 and imbalance < -0.15:
            reason = "BID_SUPPORT_LOST"

        elif signal == -1 and imbalance > 0.15:
            reason = "ASK_PRESSURE_LOST"

        if reason:

            trade = {
                "symbol": symbol,
                "signal": signal,
                "entry_price": entry,
                "exit_price": price,
                "entry_time": position["entry_time"],
                "exit_time": timestamp,
                "pnl_pct": pnl_pct,
                "exit_reason": reason
            }

            self.completed_trades.append(
                trade
            )

            del self.positions[symbol]

            return trade

        return None
